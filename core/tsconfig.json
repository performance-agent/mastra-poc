{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@pa/core": ["packages/core/src/index.ts"],
      "@pa/sdk": ["packages/sdk/src/index.ts"],
      "@pa/plugin-github": ["packages/plugin-github/src/index.ts"],
      "@pa/plugin-jira": ["packages/plugin-jira/src/index.ts"],
      "@pa/plugin-salesforce": ["packages/plugin-salesforce/src/index.ts"]
    }
  },
  "include": ["packages/core/src/index.ts", "packages/sdk/src/index.ts", "packages/plugin-github/src/index.ts", "packages/plugin-jira/src/index.ts", "packages/plugin-salesforce/src/index.ts", "tests/*.test.ts"]
}
