{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "intent",
    "filters",
    "calls",
    "ticketKeys",
    "confidence",
    "suggestedQuestions",
    "explanation"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "repo_activity",
        "project_docs",
        "tickets_status",
        "ticket_evidence",
        "pull_request_search",
        "developer_activity",
        "unknown"
      ]
    },
    "filters": {
      "type": "object",
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "groupId": { "type": "string" },
        "integrationId": { "type": "string" },
        "resourceId": { "type": "string" },
        "resourceIds": { "type": "array", "items": { "type": "string" } },
        "group": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["org", "team", "repo-list", "topic", "unknown"]
            },
            "identifier": { "type": "string" }
          }
        },
        "since": { "type": "string" },
        "until": { "type": "string" },
        "author": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "paths": { "type": "array", "items": { "type": "string" } },
        "ticketKeys": { "type": "array", "items": { "type": "string" } }
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "params", "priority"],
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "resolveGroupToRepos",
              "resolveRepoResourceId",
              "getRepositoryActivity",
              "listCommits",
              "getCommitDetails",
              "listPullRequests",
              "getPullRequestDetails",
              "listPullRequestFiles",
              "listIssues",
              "getRepoContents",
              "searchCode"
            ]
          },
          "params": { "type": "object" },
          "priority": { "type": "number", "minimum": 1, "maximum": 100 },
          "note": { "type": "string" }
        }
      },
      "maxItems": 20
    },
    "ticketKeys": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "suggestedQuestions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "explanation": {
      "type": "string"
    }
  }
}
