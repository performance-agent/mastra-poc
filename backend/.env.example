OPENAI_API_KEY=your-api-key 
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
BACKEND_PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
CORS_ORIGIN=http://localhost:5173
GITHUB_APP_ID=your-github-app-id
GITHUB_PRIVATE_KEY=your-github-app-private-key
GITHUB_SETUP_URL=your-github-app-setup-url
GITHUB_BASE_URL=https://api.github.com
# Host path mounted by compose as the Firebase application-default credential.
FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json
# LangChain provider:model identifiers used by the evaluation agent
RULE_UNDERSTANDING_MODEL=openai:gpt-5-mini
RULE_SUMMARY_MODEL=openai:gpt-5
# LangSmith tracing for backend-triggered evaluation flows
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=mastra-poc-agent-flow
# Flush traces before short-lived processes exit; harmless for the long-running API.
LANGCHAIN_CALLBACKS_BACKGROUND=false
