# Gemini free-tier content may be used by Google to improve its products.
GROUP_REPORT_MODEL=google/gemini-3.6-flash
WEATHER_AGENT_MODEL=google/gemini-3.5-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=your-google-generative-ai-api-key
# Alternative credential when selecting an OpenAI model above.
OPENAI_API_KEY=your-openai-api-key
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
BACKEND_PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Public origins used by the MCP OAuth 2.1 flow. Production values must use HTTPS.
PUBLIC_API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
GITHUB_APP_ID=your-github-app-id
GITHUB_PRIVATE_KEY=your-github-app-private-key
GITHUB_SETUP_URL=your-github-app-setup-url
GITHUB_BASE_URL=https://api.github.com
GOOGLE_APPLICATION_CREDENTIALS=your-google-application-credentials-file-path.json
# LangChain provider:model identifiers used by the evaluation agent
RULE_UNDERSTANDING_MODEL=groq:openai/gpt-oss-20b
RULE_SUMMARY_MODEL=groq:openai/gpt-oss-20b
# Optional text analysis before the team's structured synthesis (does not assess rules).
# Leave unset to use direct structured synthesis. Specific vendor/model:free IDs also work.
# TEAM_ANALYSIS_MODEL=openrouter:openrouter/free
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_OPENROUTER_FREE_INPUT_BYTES=48000
# OPENROUTER_OPENROUTER_FREE_OUTPUT_TOKENS=4096
# json, toon, or auto. Auto uses TOON only when it is smaller than compact JSON.
PROMPT_DATA_FORMAT=auto
# LangSmith tracing for backend-triggered evaluation flows
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=mastra-poc-agent-flow
# Identifies this environment in LangSmith run tags (use a deployment ID in deploys).
LANGSMITH_RUNNER_ID=local
# Flush traces before short-lived processes exit; harmless for the long-running API.
LANGCHAIN_CALLBACKS_BACKGROUND=false

# Mastra uses groq/openai/gpt-oss-20b; LangChain uses groq:openai/gpt-oss-20b.
GROQ_API_KEY=your-groq-api-key
TASK_ANALYSIS_MODEL=groq:openai/gpt-oss-20b
# Optional comma-separated Gemini/Groq model identifiers. Configure only free-tier accounts.
FREE_TIER_FALLBACK_MODELS=
GENERATION_INPUT_BYTES=48000
GENERATION_OUTPUT_TOKENS=4096
GENERATION_TIMEOUT_MS=90000
# Per-model overrides use the uppercase model identifier with punctuation replaced by underscores:
# GROQ_OPENAI_GPT_OSS_20B_INPUT_BYTES=48000
# GROQ_OPENAI_GPT_OSS_20B_OUTPUT_TOKENS=4096
# GROQ_OPENAI_GPT_OSS_20B_TIMEOUT_MS=90000
