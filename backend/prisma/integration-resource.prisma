model IntegrationResource {
  id          String                  @id @default(cuid())
  name        String
  description String?
  externalId  String
  type        IntegrationResourceType

  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  createdAt                      DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime                        @updatedAt @db.Timestamptz(3)
  githubRepository               GithubRepository?
  integrationResourceAssignments IntegrationResourceAssignment[]

  @@unique([integrationId, externalId])
  @@index([integrationId])
}

enum IntegrationResourceType {
  REPOSITORY
}

model IntegrationResourceAssignment {
  id String @id @default(cuid())

  resourceId  String
  resource    IntegrationResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace   Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?              @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
}
