model IntegrationConnection {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  pluginId       String
  connectionName String
  provider       String
  status         String
  setupKind      String

  externalId             String?
  providerInstallationId String?
  cloudId                String?
  accountLogin           String?
  accountType            String?
  accountAvatarUrl       String?
  accountUrl             String?
  siteUrl                String?
  legacyIntegrationId    String? @unique
  metadata               Json?

  resources CanonicalResource[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, provider, externalId])
  @@unique([organizationId, provider, providerInstallationId])
  @@unique([organizationId, provider, cloudId])
  @@index([organizationId])
  @@index([pluginId])
  @@index([provider])
  @@index([status])
}

model CanonicalResource {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  provider         String
  resourceType     String
  externalId       String
  name             String?
  url              String?
  legacyResourceId String? @unique
  metadata         Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([organizationId, connectionId, resourceType, externalId])
  @@index([organizationId])
  @@index([connectionId])
  @@index([provider])
  @@index([resourceType])
}
