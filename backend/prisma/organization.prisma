model Organization {
  id          String  @id @default(cuid())
  name        String
  description String?
  photoUrl    String?

  workspaces Workspace[]

  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  integrations Integration[]
  memberships  Membership[]
}
